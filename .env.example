# ============================================================
# Agent Workbench —— 环境变量样例
# 复制为 .env 后按需填写。**不要**把真实密钥提交到仓库。
# 全部文件必须为 UTF-8 无 BOM。
# ============================================================

# ---------- 数据库（compose.yaml 启动的 PostgreSQL） ----------
WORKBENCH_DATABASE_URL=postgresql+psycopg://workbench:workbench@127.0.0.1:55432/workbench
# 框架 Checkpointer / Store 使用独立 schema，与业务 app schema 隔离
WORKBENCH_CHECKPOINT_SCHEMA=agent_checkpoint
WORKBENCH_MEMORY_SCHEMA=agent_memory
WORKBENCH_APP_SCHEMA=app
WORKBENCH_DB_POOL_MIN=4
WORKBENCH_DB_POOL_MAX=8
WORKBENCH_DB_CONNECT_TIMEOUT_SECONDS=10

# ---------- 控制端服务 ----------
WORKBENCH_API_HOST=127.0.0.1
WORKBENCH_API_PORT=8770
# 浏览器同源 Cookie 会话 + 本地访问令牌；两个都必填
WORKBENCH_SESSION_SECRET=change-me-local-session-secret
WORKBENCH_ACCESS_TOKEN=change-me-local-access-token
WORKBENCH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 单用户本地 owner 标识（首版固定，不省略项目隔离）
WORKBENCH_OWNER_ID=local-owner

# ---------- 运行数据目录（源码包之外） ----------
# 默认使用当前仓库的 data/；需要迁移数据目录时再取消注释并填写自己的绝对路径。
# WORKBENCH_DATA_ROOT=D:/my-workbench-data
# ~ 由部署脚本按 SSH 登录用户的 home 展开，不依赖用户名必须是 kali。
WORKBENCH_REMOTE_DATA_ROOT=~/rexak-agent-data

# ---------- 模型供应商 ----------
WORKBENCH_DEFAULT_PROVIDER=xiaomi
# 密钥使用 secret_ref：实际值来自本机 SecretStore 或环境变量，不写入仓库
XIAOMI_API_KEY=
XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1
XIAOMI_MODEL=mimo-v2.6-pro
# 百炼：使用控制台中含业务空间 ID 和地域的 OpenAI 兼容 Base URL。
# 例如 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 双击启动后在 Web 模型设置中选择模型、填写并持久保存 Key；不会写回此文件。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=deepseek-v4.1-flash
# 上下文与输出以版本化官方档案为准，不再使用 DASHSCOPE_CONTEXT_LIMIT。
WORKBENCH_SECRET_STORE_PATH=~/.workbench/secrets.json

# ---------- 上下文与并发（可调资源初值，不是总时长/费用上限） ----------
WORKBENCH_CONTEXT_TRIGGER_RATIO=0.6
# 内置模型不再使用 WORKBENCH_OUTPUT_RESERVE_TOKENS / WORKBENCH_RECOVERY_OUTPUT_LIMIT_TOKENS。
WORKBENCH_TOOL_MAX_CONCURRENT=4
WORKBENCH_ORIGIN_MAX_CONCURRENT=2
WORKBENCH_BROWSER_WRITE_MAX_CONCURRENT=1

# ---------- Executor / 执行岛 ----------
WORKBENCH_EXECUTOR_ID=kali-01
# 必填自己的 Kali IP 或可解析主机名；不要提交个人地址。
WORKBENCH_EXECUTOR_HOST=
WORKBENCH_EXECUTOR_PORT=22
WORKBENCH_EXECUTOR_USER=kali
WORKBENCH_EXECUTOR_SSH_KEY=~/.ssh/id_ed25519
WORKBENCH_EXECUTOR_KNOWN_HOSTS=~/.ssh/known_hosts
WORKBENCH_EXECUTOR_INSTALL_ROOT=~/rexak-agent-executor
# Kali 上用于创建 venv 的解释器，要求 3.12 或 3.13；可改成已安装的 python3.13。
WORKBENCH_EXECUTOR_PYTHON=python3
# 可选的公开 HTTPS 包源；留空沿用 Kali pip 默认配置，不填写用户名、密码或令牌。
WORKBENCH_EXECUTOR_PIP_INDEX_URL=
# 执行岛回环地址上的 Executor 端口（控制端经 SSH 隧道访问）
WORKBENCH_EXECUTOR_REMOTE_PORT=8791
# 隧道建立后控制端使用的本地回环端口（0 = 自动分配）
WORKBENCH_EXECUTOR_LOCAL_PORT=0
# 执行岛对控制端令牌的校验值
WORKBENCH_EXECUTOR_TOKEN=change-me-executor-token
# 断线宽限与会话授权租期（秒），P3 依据本地网络实验定稿
WORKBENCH_EXECUTOR_GRACE_SECONDS=300

# ---------- 任务生命周期 ----------
WORKBENCH_TOOL_INTERACTIVE_THRESHOLD_SECONDS=20
WORKBENCH_SINGLE_OPERATION_TIMEOUT_SECONDS=120
WORKBENCH_MODEL_REQUEST_TIMEOUT_SECONDS=300
# 以上为无有效分片的等待上限；持续生成的单次调用最多等待 1800 秒。
WORKBENCH_MODEL_REQUEST_MAX_SECONDS=1800
WORKBENCH_RUN_LEASE_SECONDS=60
WORKBENCH_LEASE_HEARTBEAT_SECONDS=15
# 图受控片段工作阈值（达到后在安全边界落 checkpoint 并调度下一片段）
WORKBENCH_SEGMENT_STEP_THRESHOLD=40

# ---------- 保留与上限 ----------
# 仅供显式 workbench prune-events 命令使用；不会随服务启动自动清理
WORKBENCH_EVENT_RETENTION_DAYS=30
WORKBENCH_INLINE_OUTPUT_LIMIT_BYTES=65536
WORKBENCH_JOB_OUTPUT_LIMIT_BYTES=10485760
# 默认使用当前仓库的 backups/；需要时填写自己的绝对路径。
# WORKBENCH_BACKUP_PATH=D:/my-workbench-backups

# ---------- 前端（Vite dev server 代理 /api） ----------
VITE_API_BASE=/api
